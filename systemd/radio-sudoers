# Устанавливается в /etc/sudoers.d/radio-panel командой:
#   sudo visudo -cf radio-sudoers && sudo cp radio-sudoers /etc/sudoers.d/radio-panel
#
# Разрешает пользователю "radio" (от имени которого работает портал)
# перезапускать ТОЛЬКО liquidsoap-radio и icecast2, и ничего больше.
#
# ВАЖНО: liquidsoap-radio — это ОБЩИЙ движок на все радиостанции портала.
# Перезапуск через панель (кнопка TRANSPORT, портал или любая админка
# станции) применяет изменения сразу для ВСЕХ станций, а не только для
# той, из чьей админки был вызван restart. Это осознанное следствие
# архитектуры "один процесс на все станции" — см. README.md.

radio ALL=(root) NOPASSWD: /usr/bin/systemctl restart liquidsoap-radio
radio ALL=(root) NOPASSWD: /usr/bin/systemctl restart icecast2
radio ALL=(root) NOPASSWD: /usr/bin/systemctl is-active liquidsoap-radio
radio ALL=(root) NOPASSWD: /usr/bin/systemctl is-active icecast2

# Восстановление владельца файлов медиатеки (radio:radio) — нужно, когда
# файлы попадают в папку станции в обход панели (например, через WinSCP/SFTP
# от другого пользователя). Скрипт без аргументов — путь читает сам из
# реестра, поэтому команда полностью статична и безопасна для NOPASSWD.
radio ALL=(root) NOPASSWD: /home/claude/radio-project/scripts/fix-media-permissions.sh

# ВНИМАНИЕ: это НЕ то же самое, что restart выше — это полная перезагрузка
# ОПЕРАЦИОННОЙ СИСТЕМЫ сервера. Роняет вообще всё: все станции, сам портал,
# SSH-доступ — на время перезагрузки (обычно 1-3 минуты, зависит от хостинга).
# Кнопка в интерфейсе защищена двойным подтверждением именно из-за масштаба
# этой команды.
radio ALL=(root) NOPASSWD: /usr/bin/systemctl reboot
