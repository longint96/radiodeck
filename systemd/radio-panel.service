[Unit]
Description=Radio Control Panel (backend)
After=network.target

[Service]
Type=simple
User=radio
Group=radio
WorkingDirectory=/home/claude/radio-project/backend
EnvironmentFile=/home/claude/radio-project/backend/.env
ExecStart=/usr/bin/node /home/claude/radio-project/backend/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
